{
	"name": "kumidocs",
	"version": "0.0.0",
	"description": "A developer-focused wiki/docs platform with zero database: all content stored in Git.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Foorack/kumidocs.git"
	},
	"keywords": [
		"wiki",
		"docs",
		"markdown",
		"git",
		"bun",
		"self-hosted"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"bun": ">=1.1.0"
	},
	"files": [
		"dist"
	],
	"bin": {
		"kumidocs": "dist/index.js"
	},
	"type": "module",
	"scripts": {
		"build": "bun scripts/build.ts",
		"postinstall": "bun scripts/postinstall.ts",
		"prepublishOnly": "bun run build",
		"dev": "bun --hot src/index.ts",
		"start": "NODE_ENV=production bun src/index.ts",
		"lint": "oxlint src/ e2e/ playwright.config.ts",
		"format": "oxfmt src/ e2e/ playwright.config.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@iconify-json/devicon": "1.2.62",
		"@iconify-json/flag": "1.2.12",
		"@iconify-json/fluent-color": "1.2.21",
		"@iconify-json/glyphs-poly": "1.2.0",
		"@iconify-json/logos": "1.2.11",
		"@noble/hashes": "2.2.0",
		"@radix-ui/react-label": "2.1.10",
		"@radix-ui/react-slot": "1.3.0",
		"@streamdown/cjk": "1.0.3",
		"@streamdown/code": "1.1.1",
		"@streamdown/math": "1.0.2",
		"@streamdown/mermaid": "1.0.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"color": "5.0.3",
		"diff": "9.0.0",
		"html2canvas-pro": "2.2.0",
		"ignore": "7.0.5",
		"jspdf": "4.2.1",
		"khroma": "2.1.0",
		"linkedom": "^0.18.13",
		"lucide-react": "1.21.0",
		"minisearch": "7.2.0",
		"next-themes": "0.4.6",
		"radix-ui": "1.6.0",
		"react": "19.2.7",
		"react-diff-view": "3.3.3",
		"react-dom": "19.2.7",
		"react-router-dom": "7.18.0",
		"rehype-harden": "1.1.8",
		"sonner": "2.0.7",
		"streamdown": "2.5.0",
		"tailwind-merge": "3.6.0",
		"ws": "8.21.0"
	},
	"devDependencies": {
		"@playwright/test": "1.64.1",
		"@tailwindcss/typography": "0.5.20",
		"@types/bun": "1.4.4",
		"@types/color": "4.2.1",
		"@types/node": "26.6.6",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@types/ws": "8.18.2",
		"bun-plugin-tailwind": "0.1.2",
		"country-flag-icons": "1.6.20",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"tailwindcss": "4.3.4",
		"tw-animate-css": "1.4.0",
		"typescript": "7.0.2"
	}
}